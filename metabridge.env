# Copy to metabridge.env and fill in. metabridge.env is git-ignored and never leaves this machine.
# Cirrus Direct Metadata Posting (SecureNet)
METABRIDGE_CIRRUS_CALLSIGN=WERUDB
METABRIDGE_CIRRUS_TOKEN=0339420E-047A-4694-8583-B140183D0D8C
# METABRIDGE_CIRRUS_RESPONSE=xml
METABRIDGE_CIRRUS_DRY_RUN=0

# Which outputs run on every track change
METABRIDGE_OUTPUTS=log,securenet_cirrus

# Optional
# METABRIDGE_WEBHOOK_URL=
# METABRIDGE_TCP_PORT=8766
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
METABRIDGE_TCP_PORT=8766
